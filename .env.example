# Copy to .env (docker compose reads it automatically).

# Port the web UI listens on (host networking: this is the real host port).
WEB_PORT=8080
# Image source for `docker compose up` (Docker Hub). IMAGE_TAG can pin a version.
REGISTRY_USER=julianh2o
IMAGE_TAG=latest
# lightd REST API port.
DAEMON_PORT=8765
# Interface the lightd API binds to. The API has no auth; use 127.0.0.1 to keep it
# local (the web UI still works via its /engine proxy).
DAEMON_API_HOST=0.0.0.0
# Frames per second sent to the boards.
LIGHTD_FPS=30
# Render frames but send nothing on the network.
LIGHTD_DRY_RUN=false
# Old simulator's visualizer port (parked sim profile only).
SIM_WEB_PORT=8090
# Pattern assistant (chat under the editor). Any OpenAI-compatible API; leave empty to turn it off.
#   Ollama:   ASSISTANT_BASE_URL=http://10.10.0.40:11434/v1   ASSISTANT_MODEL=qwen3-8-64k:latest
#   DeepSeek: ASSISTANT_BASE_URL=https://api.deepseek.com     ASSISTANT_MODEL=deepseek-chat  ASSISTANT_API_KEY=sk-...
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
