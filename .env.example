# Copy to .env (docker compose reads it automatically).

# Port the web UI listens on (host networking: this is the real host port).
WEB_PORT=8080
# Image source for `docker compose up` (Docker Hub). IMAGE_TAG can pin a version.
REGISTRY_USER=julianh2o
IMAGE_TAG=latest
# Daemon REST API port. Exposed on all interfaces so the Java Universe Manager can connect.
DAEMON_PORT=8765
# Interface the daemon API binds to. The API has no auth; use 127.0.0.1 to keep it
# local (the web UI still works via its /engine proxy).
DAEMON_API_HOST=0.0.0.0
# Target frames per second.
WLED_FPS=30
# Subnet broadcast address used for the DDP frame-sync packet, e.g. 192.168.1.255.
WLED_BROADCAST_IP=255.255.255.255
# Build frames but send nothing on the network.
WLED_DRY_RUN=false
# true = target the simulator (127.0.0.1, ports 4048+idx) instead of config/controllers.json.
# Set this when running with `--profile sim`.
WLED_SIMULATOR=false
# Simulator visualizer port (sim profile only).
SIM_WEB_PORT=8090
