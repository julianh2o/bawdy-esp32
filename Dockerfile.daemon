# lightd: runs Lua patterns on WLED controller channels and owns the configuration
# (controllers.json, user patterns, run state under /config), with a REST API on 8765.
#
#   docker build -f Dockerfile.daemon -t bawdy-lights-daemon .
#   docker build -f Dockerfile.daemon --target sim -t bawdy-lights-sim .   # old simulator (parked)
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

RUN useradd --create-home --uid 10001 wled
WORKDIR /app

RUN pip install --no-cache-dir "rich>=13.0.0" "prompt_toolkit>=3.0.0"

COPY run.py sim.py ./
COPY src ./src
# Built-in presets are baked in as defaults; real config is mounted at /config.
COPY data/presets ./data/presets

# --- simulator (virtual WLED boards + web visualizer) -----------------------
FROM base AS sim
RUN pip install --no-cache-dir "aiohttp>=3.9"
USER wled
EXPOSE 8080
CMD ["python", "sim.py", "--universe", "/config/universe.json", "--patch", "/config/patch.json", "--web-host", "0.0.0.0", "--no-browser"]

# --- daemon (default target): lightd ----------------------------------------
FROM base AS daemon

RUN pip install --no-cache-dir "zeroconf>=0.131" "lupa>=2.0"
COPY patterns ./patterns

ARG VERSION=unknown
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="bawdy-lights-daemon"
LABEL org.opencontainers.image.description="lightd: Lua patterns on WLED controller channels, REST API + DDP output"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.authors="Julian Hartline <https://www.julianhartline.com>"
LABEL org.opencontainers.image.url="https://hub.docker.com/r/julianh2o/bawdy-lights-daemon"
LABEL org.opencontainers.image.source="https://github.com/julianh2o/bawdy-esp32"

# Settings are env vars (below) or CLI args appended to the command. The API binds all
# interfaces and has no authentication (see TODO.md #7); set LIGHTD_HOST=127.0.0.1 to keep it local.
# lightd writes to /config (controllers.json, patterns/, scenes.json, lightd-state.json): mount it read-write
# and make it writable by uid 10001.
ENV APP_VERSION="${VERSION}" \
    LIGHTD_HOST=0.0.0.0 \
    LIGHTD_PORT=8765 \
    LIGHTD_FPS=30 \
    CONTROLLERS_FILE=/config/controllers.json \
    USER_PATTERNS_DIR=/config/patterns \
    LIGHTD_STATE=/config/lightd-state.json \
    SCENES_FILE=/config/scenes.json \
    BUILTIN_PATTERNS_DIR=/app/patterns

USER wled
EXPOSE 8765

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import os,urllib.request as u; u.urlopen('http://127.0.0.1:%s/api/status' % os.environ.get('LIGHTD_PORT','8765'), timeout=2)"

# Exec form so the Python process is PID 1 and receives SIGTERM (blackout on stop).
ENTRYPOINT ["python", "-m", "lightd"]
