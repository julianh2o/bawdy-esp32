# Browser UI: static files (pattern editor at /, /config setup) + /engine/* proxy to lightd, which owns the
# configuration.
#
#   docker build -f Dockerfile.web -t bawdy-lights-web .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

RUN useradd --create-home --uid 10001 wled
WORKDIR /app

RUN pip install --no-cache-dir "rich>=13.0.0"

COPY sequencer.py ./
COPY src/wled_sequencer ./src/wled_sequencer

ARG VERSION=unknown
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="bawdy-lights-web"
LABEL org.opencontainers.image.description="Browser UI (pattern editor and setup) for the bawdy WLED lighting engine"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.authors="Julian Hartline <https://www.julianhartline.com>"
LABEL org.opencontainers.image.url="https://hub.docker.com/r/julianh2o/bawdy-lights-web"
LABEL org.opencontainers.image.source="https://github.com/julianh2o/bawdy-esp32"

ENV APP_VERSION="${VERSION}" \
    SEQUENCER_HOST=0.0.0.0 \
    SEQUENCER_PORT=8080 \
    ENGINE_URL=http://127.0.0.1:8765

USER wled
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import os,urllib.request as u; u.urlopen('http://127.0.0.1:%s/' % os.environ.get('SEQUENCER_PORT','8080'), timeout=2)"

# Server-only mode: no browser launch. Exec form keeps Python as PID 1 for SIGTERM.
ENTRYPOINT ["python", "sequencer.py", "--web", "--no-browser"]
