# Browser sequencer UI: static files + /api/sequences storage + /engine/* proxy to the daemon.
#
#   docker build -f Dockerfile.web -t bawdy-web .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

RUN useradd --create-home --uid 10001 wled \
    && mkdir -p /data/sequences \
    && chown wled /data/sequences
WORKDIR /app

RUN pip install --no-cache-dir "rich>=13.0.0"

COPY sequencer.py ./
COPY src/wled_sequencer ./src/wled_sequencer

ENV SEQUENCER_HOST=0.0.0.0 \
    SEQUENCER_PORT=8080 \
    SEQUENCES_DIR=/data/sequences \
    ENGINE_URL=http://127.0.0.1:8765

USER wled
VOLUME /data/sequences
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import os,urllib.request as u; u.urlopen('http://127.0.0.1:%s/api/sequences' % os.environ.get('SEQUENCER_PORT','8080'), timeout=2)"

# Server-only mode: no browser launch. Exec form keeps Python as PID 1 for SIGTERM.
ENTRYPOINT ["python", "sequencer.py", "--web", "--no-browser"]
