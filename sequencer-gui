#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR_FILE="$ROOT_DIR/sequencer-java/target/wled-sequencer.jar"

if [ ! -f "$JAR_FILE" ]; then
  echo "⚡ Building Pattern Sequencer JAR..."
  "$ROOT_DIR/sequencer-java/build.sh"
fi

echo "🎛️ Launching WLED Universe Manager [Java 17 Swing]..."
exec java -Dawt.useSystemAAFontSettings=on -Dswing.aatext=true -jar "$JAR_FILE" \
  --sequences "$ROOT_DIR/sequences" \
  --universe "$ROOT_DIR/data/venue/universe.json" \
  --patch "$ROOT_DIR/data/venue/patch.json" \
  --engine "${ENGINE_URL:-http://127.0.0.1:8765}" \
  "$@"
